    "creatorVersion": "3.8.4",
    "designResolution": {
      "width": 640,
      "height": 1136
    },
    "orientation": "portrait"
  },
  "scope": {
    "included": [
      "圆形大地图与镜头跟随",
      "玩家持续移动和触摸、鼠标、键盘方向控制",
      "数字道具随机生成、直接收集、排序和 2048 合并",
      "吞噬后的数字从碰撞位置接入并沿队首历史轨迹弹性跟随",
      "本地 AI 敌人移动、收集和角色碰撞",
      "按角色首位数字比较的吞噬或相同数字合并",
      "圆形边界限制、回推和蹭边动画",
      "分数、排名、操作提示、失败和重新开始界面",
      "启动、2048 大厅、游戏三个独立场景及完整往返流程",
      "场景跳转防重复操作、失败提示和可恢复重试"
    ],
    "excluded": [
      "联网真人玩家和服务器同步",
      "账号、匹配、排行榜服务和持久化存档",
      "正式美术、音效、商业化和数值平衡",
      "参考游戏中与本 Demo 规则无关的完整产品功能"
    ]
  },
  "decisions": [
    {
      "id": "decision-continuous-steering",
      "statement": "角色持续向前移动，玩家通过触摸、鼠标或方向键只控制朝向，镜头跟随玩家。",
      "confidence": "confirmed",
      "impact": "behavior",
      "sources": [
        "requirement-chat",
        "design-reference"
      ]
    },
    {
      "id": "decision-prop-direct-consume",
      "statement": "地图数字道具与任何角色接触后都会被直接吃掉，不与角色比较大小。",
      "confidence": "confirmed",
      "impact": "behavior",
      "sources": [
        "requirement-chat"
      ]
    },
    {
      "id": "decision-segment-merge",
      "statement": "吃到的数字进入角色数字队列；不同数字按从大到小排列，相同数字连续合并，直到不能继续合并。",
      "confidence": "explicit",
      "impact": "behavior",
      "sources": [
        "requirement-chat"
      ]
    },
    {
      "id": "decision-tail-follow",
      "statement": "吞噬后新增的数字从实际碰撞位置接入尾巴，逐渐拉开到目标间距，并通过独立平滑状态沿队首连续历史轨迹跟随；不能瞬移到固定槽位。",
      "confidence": "explicit",
      "impact": "behavior",
      "sources": [
        "requirement-tail-follow"
      ]
    },
    {
      "id": "decision-actor-collision",
      "statement": "只有角色之间碰撞才比较首位数字；大数吞噬小数，相同数字由碰撞胜方吞噬并把双方数字队列重新排序合并。",
      "confidence": "explicit",
      "impact": "behavior",
      "sources": [
        "requirement-chat"
      ]
    },
    {
      "id": "decision-equal-collision-owner",
      "statement": "Demo 中玩家与相同首位数字的 AI 相撞时玩家获胜；AI 之间相同数字相撞时由主动接近的一方获胜。",
      "confidence": "inferred",
      "impact": "behavior",
      "sources": [
        "requirement-chat"
      ],
      "reason": "用户已明确同值碰撞时玩家吃掉对方；AI 对 AI 的归属是 Demo 必需且可逆的本地规则。"
    },
    {
      "id": "decision-boundary-response",
      "statement": "角色不能越过圆形边界，触边时播放压缩和火花反馈，并把方向缓慢推回地图内部。",
      "confidence": "confirmed",
      "impact": "behavior",
      "sources": [
        "requirement-chat",
        "design-reference"
      ]
    },
    {
      "id": "decision-procedural-visuals",
      "statement": "Demo 使用 Graphics 和 Label 程序化绘制方形数字块、地图、网格和反馈，不引入临时图片资源。",
      "confidence": "inferred",
      "impact": "structure",
      "sources": [
        "project-rules",
        "design-reference"
      ],
      "reason": "当前目标是先完成可玩 Demo，程序化 2D 图形可以保持资源结构干净并快速验证玩法。"
    },
    {
      "id": "decision-three-scene-flow",
      "statement": "应用固定使用 Boot、Lobby、Game2048 三个场景；启动完成进入大厅，大厅开始游戏，游戏中和结算后均可返回大厅。",
      "confidence": "explicit",
      "impact": "structure",
      "sources": [
        "requirement-three-scene-flow"
      ]
    },
    {
      "id": "decision-transition-recovery",
      "statement": "场景跳转期间禁用重复操作，跳转失败时恢复按钮并显示可重试状态，避免界面卡死。",
      "confidence": "inferred",
      "impact": "behavior",
      "sources": [
        "requirement-three-scene-flow",
        "project-rules"
      ],
      "reason": "三个场景存在异步切换，失败路径必须可见且可恢复，才能形成稳定的完整流程。"
    }
  ],
