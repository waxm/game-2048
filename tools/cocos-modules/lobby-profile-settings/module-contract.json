  "scope": {
    "included": [
      "2048 大厅左上玩家头像、玩家名、身份说明和资料入口",
      "六个冷色数字头像的选择、对象池复用和本地持久化",
      "玩家名称编辑、Unicode 长度限制和损坏存档回退",
      "2048 大厅右上设置入口",
      "冷色调底部设置面板",
      "游戏声音和震动反馈开关及本地持久化",
      "拼图首页昵称间距、宽度和长文本缩放修正"
    ],
    "excluded": [
      "账号系统、头像上传和远程玩家资料",
      "音频资源制作、背景音乐曲目接入和系统级震动权限申请",
      "拼图设置业务或其他拼图 UI 重构",
      "2048 核心玩法规则修改"
    ]
  },
  "decisions": [
    {
      "id": "decision-reference-structure",
      "statement": "沿用拼图首页左侧头像昵称、右侧设置入口、头像资料弹窗和设置弹层的交互骨架，但使用 2048 独立业务键与冷色图形资源。",
      "confidence": "explicit",
      "impact": "structure",
      "sources": ["requirement-chat", "puzzle-profile-reference", "puzzle-settings-reference"]
    },
    {
      "id": "decision-cool-theme",
      "statement": "2048 新界面使用深海军蓝、冰青和靛紫色，数字示例块同步改为冷色系。",
      "confidence": "explicit",
      "impact": "polish",
      "sources": ["requirement-chat"]
    },
    {
      "id": "decision-local-profile",
      "statement": "无账号来源时使用版本化本地资料，提供名称编辑和六个稳定编号头像，不伪造远程资料或上传能力。",
      "confidence": "inferred",
      "impact": "behavior",
      "sources": ["requirement-chat", "project-rules"],
      "reason": "当前项目没有账号接口，静态默认资料可完整实现展示需求且后续可由真实适配器替换。"
    },
    {
      "id": "decision-audio-settings",
      "statement": "设置面板提供统一游戏声音和震动反馈开关；声音同步 AudioManager 两个音量通道，设置使用 game2048 独立版本化存档。",
      "confidence": "inferred",
      "impact": "behavior",
      "sources": ["requirement-chat", "project-rules"],
      "reason": "拼图参考实现使用声音与震动两项设置；2048 复用现有 AudioManager 和浏览器震动能力即可形成真实闭环。"
    },
    {
      "id": "decision-puzzle-name-fix",
      "statement": "拼图首页昵称向右移动 4 像素、宽度收窄 10 像素并使用 SHRINK，给头像留出稳定间距且避免长昵称越界。",
      "confidence": "inferred",
      "impact": "polish",
      "sources": ["requirement-chat", "puzzle-profile-reference"],
      "reason": "原昵称左边界距离头像仅 3 像素，CLAMP 会直接裁掉长名称；增加间距并自动缩小能同时覆盖短名和长名。"
    },
    {
      "id": "decision-settings-layout-revision",
      "statement": "设置面板使用 520 像素高的紧凑底部卡片；开关完整收进设置行，状态文字与开关保持至少 24 像素间距，关闭和开关触摸区均不小于 72 像素，自动保存提示使用分隔线和纯辅助文字。",
      "confidence": "inferred",
      "impact": "polish",
      "sources": ["requirement-chat", "project-rules"],
      "reason": "实际 Canvas 基线显示开关越出行卡片、状态文字贴近开关、触摸高度不足、提示区像禁用按钮且面板底部存在约 132 像素无效空白。"
    },
    {
      "id": "decision-profile-layout-revision",
      "statement": "资料面板保持现有存档与头像对象池逻辑，重排当前头像、名称和说明为从左到右阅读；名称输入区增加独立的常驻文本显示，面板内容统一使用 48 像素边距，关闭和保存触摸区不小于 72 像素。",
      "confidence": "inferred",
      "impact": "polish",
      "sources": ["requirement-chat", "project-rules"],
      "reason": "实际 Canvas 基线显示当前头像覆盖名称、输入框没有名称文字、章节标题贴近外框且关闭与保存触摸高度不足。"
    }
  ],
