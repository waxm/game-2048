  "architecture": {
    "artifacts": [
      {
        "id": "lobby-view",
        "role": "view",
        "responsibility": "显示冷色大厅、默认头像、昵称和设置入口。"
      },
      {
        "id": "lobby-controller",
        "role": "controller",
        "responsibility": "绑定资料与设置入口、配置 UI 根节点、响应资料事件并防止重复打开请求。"
      },
      {
        "id": "profile-panel",
        "role": "view",
        "responsibility": "编辑本地名称、展示当前头像并使用对象池渲染六个头像选项。"
      },
      {
        "id": "avatar-item",
        "role": "item",
        "responsibility": "从对象池复用并渲染一个头像定义、名称和当前选中状态。"
      },
      {
        "id": "settings-panel",
        "role": "view",
        "responsibility": "渲染底部设置弹层、处理两个开关和关闭生命周期。"
      },
      {
        "id": "profile-settings-storage",
        "role": "adapter",
        "responsibility": "通过 StorageManager 保存版本化资料与设置，并通过 AudioManager 和浏览器能力应用声音与震动。"
      },
      {
        "id": "asset-generator",
        "role": "config",
        "responsibility": "使用稳定目录/资源 UUID 和 Creator 实际类 ID重复生成大厅 Scene、资料、设置和头像项 Prefab。"
      }
    ]
  },
  "interfaces": [
    {
      "id": "local-profile-settings",
